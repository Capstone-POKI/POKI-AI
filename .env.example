# Google Cloud
PROJECT_ID=pitchcoachai
LOCATION=us

# DocumentAI Processor IDs
OCR_PROCESSOR_ID=your_ocr_processor_id
LAYOUT_PROCESSOR_ID=your_layout_processor_id
FORM_PROCESSOR_ID=your_form_processor_id

# GCP Service Account (Docker 내부 경로)
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/service-account.json

# API Keys
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
AI_INTERNAL_API_KEY=replace_with_a_long_random_internal_key

# S3 (공고문 PDF / IR Deck PDF / 음성 파일 원본 저장 + IR 슬라이드 썸네일)
S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=ap-northeast-2
# S3_PUBLIC_BASE_URL=https://your-cdn-domain.com  # CDN 사용 시 설정
# S3_USE_PRESIGNED_URL=0                          # presigned URL 사용 시 1로 변경
# S3_PRESIGNED_EXPIRE_SEC=604800                  # presigned URL 유효기간 (초)
S3_THUMBNAIL_PREFIX=ir-thumbnails

# Thumbnail quality (IR deck slide previews)
THUMBNAIL_DPI=220
THUMBNAIL_MAX_WIDTH=1600
THUMBNAIL_FORMAT=PNG
THUMBNAIL_JPEG_QUALITY=95
THUMBNAIL_WEBP_QUALITY=95
